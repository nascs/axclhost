PACKAGE_NAME="axclhost"
PACKAGE_VERSION="#MODULE_VERSION#"
CLEAN=":"

MAKE="make -C $dkms_tree/$PACKAGE_NAME/$PACKAGE_VERSION/build/axcl/drv/pcie/driver KERNEL_VER=$kernelver host=arm64 KCFLAGS=\"-DIS_THIRD_PARTY_PLATFORM\" install"

BUILT_MODULE_NAME[0]="ax_pcie_host_dev"
DEST_MODULE_NAME[0]="${BUILT_MODULE_NAME[0]}"
BUILT_MODULE_LOCATION[0]="axcl/out/axcl_linux_arm64/ko/"
DEST_MODULE_LOCATION[0]="/updates/dkms"

BUILT_MODULE_NAME[1]="axcl_host"
DEST_MODULE_NAME[1]="${BUILT_MODULE_NAME[1]}"
BUILT_MODULE_LOCATION[1]="axcl/out/axcl_linux_arm64/ko/"
DEST_MODULE_LOCATION[1]="/updates/dkms"

BUILT_MODULE_NAME[2]="ax_pcie_mmb"
DEST_MODULE_NAME[2]="${BUILT_MODULE_NAME[2]}"
BUILT_MODULE_LOCATION[2]="axcl/out/axcl_linux_arm64/ko/"
DEST_MODULE_LOCATION[2]="/updates/dkms"

BUILT_MODULE_NAME[3]="ax_pcie_msg"
DEST_MODULE_NAME[3]="${BUILT_MODULE_NAME[3]}"
BUILT_MODULE_LOCATION[3]="axcl/out/axcl_linux_arm64/ko/"
DEST_MODULE_LOCATION[3]="/updates/dkms"

BUILT_MODULE_NAME[4]="ax_pcie_net_host"
DEST_MODULE_NAME[4]="${BUILT_MODULE_NAME[4]}"
BUILT_MODULE_LOCATION[4]="axcl/out/axcl_linux_arm64/ko/"
DEST_MODULE_LOCATION[4]="/updates/dkms"

BUILT_MODULE_NAME[5]="ax_pcie_p2p_rc"
DEST_MODULE_NAME[5]="${BUILT_MODULE_NAME[5]}"
BUILT_MODULE_LOCATION[5]="axcl/out/axcl_linux_arm64/ko/"
DEST_MODULE_LOCATION[5]="/updates/dkms"

AUTOINSTALL="yes"
